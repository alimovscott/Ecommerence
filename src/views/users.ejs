<%- include('includes/header') %>

<!-- Zamonaviy shriftlarni ulash -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<!-- FontAwesome (ikonkalar uchun) -->
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
<!-- Bizning yangi CSS faylimiz -->
<link rel="stylesheet" type="text/css" href="/css/users.css" />

<body>
  <!-- 3D Animatsiya uchun fon konteyneri -->
  <div id="canvas-container-users"></div>

  <div class="users-container">
    <% if(!member) { %>
    <!-- LOGGED OUT HOLATI -->
    <nav class="navigation-menu glass-panel">
      <ul class="nav justify-content-center">
        <li class="nav-item">
          <a class="nav-link" href="/admin/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/signup">SignUp</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/admin/login">Login</a>
        </li>
      </ul>
    </nav>

    <div class="users-frame display-flex-center">
      <div class="glass-panel message-board">
        <i class="fas fa-lock" style="font-size: 50px; margin-bottom: 20px; color: var(--accent-color);"></i>
        <div style="font-size: 30px; font-weight: 600;">Access Denied</div>
        <p>Please login first to view user data.</p>
      </div>
    </div>

    <% } else { %>
    <!-- LOGGED IN HOLATI -->
    <nav class="navigation-menu glass-panel">
      <ul class="nav justify-content-center">
        <li class="nav-item">
          <a class="nav-link" href="/admin/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/product/all">Menu</a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/admin/user/all">Users</a>
        </li>
        <li class="nav-item">
          <a class="nav-link logout-btn" href="/admin/logout" onclick="return confirm('Do you really want to logout?')">Logout</a>
        </li>
      </ul>
    </nav>

    <div class="users-frame">
      <div class="board glass-panel main-board">
        <div class="user-table-container">
          <div class="table-header">
             <span class="section-title"><i class="fas fa-users margin-right-10"></i> All Users List</span>
          </div>
          
          <div class="table-responsive glass-table-wrapper">
            <table class="table table-hover glass-table">
              <thead>
                <tr>
                  <th scope="col">No</th>
                  <th scope="col">Name</th>
                  <th scope="col">Phone</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <!--  LOOP USERS: START  -->
              <tbody>
                <% users.map(function(value, index) { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td style="font-weight: 600;"><%= value.memberNick %></td>
                    <td><%= value.memberPhone %></td>
                    <td style="width: 15%">
                      <select class="glass-select member-status" id="<%= value._id%>" data-original-value="<%= value.memberStatus %>">
                        <option value="ACTIVE" class="text-success" <%= value.memberStatus === 'ACTIVE' ? 'selected': '' %>>ACTIVE</option>
                        <option value="BLOCK" class="text-warning" <%= value.memberStatus === 'BLOCK' ? 'selected': '' %>>BLOCK</option>
                        <option value="DELETE" class="text-danger" <%= value.memberStatus === 'DELETE' ? 'selected': '' %>>DELETE</option>
                      </select>
                    </td>
                </tr>
                <% }) %>
              </tbody>
              <!--  LOOP USERS: END  -->
            </table>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <!-- Kerakli kutubxonalar -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.26.1/axios.min.js"></script>
  <!-- Three.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>