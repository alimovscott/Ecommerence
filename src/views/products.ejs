<%- include('includes/header') %>

<!-- Zamonaviy shriftlarni ulash -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<!-- Bizning yangi CSS faylimiz -->
<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
    <!-- 3D Animatsiya uchun fon konteyneri -->
    <div id="canvas-container-products"></div>

    <div class="products-container">
        <!-- Navigatsiya menyusi (Glassmorphism) -->
        <nav class="navigation-menu glass-panel">
            <ul class="nav justify-content-center">
                <li class="nav-item">
                    <a class="nav-link" href="/admin/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="/admin/product/all">Menu</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin/user/all">Users</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link logout-btn" href="/admin/logout" onclick="return confirm('Do you want to logout?')">Logout</a>
                </li>
            </ul>
        </nav>

        <div class="restaurant-menu-frame">
            <div class="board glass-panel main-board">
                
                <!-- PRODUCTS LIST SECTION -->
                <div class="dishes-table-container">
                    <div class="table-header">
                        <span class="section-title">Product List</span>
                        <button class="btn glass-btn-primary" id="process-btn">
                           + New Product
                        </button>
                    </div>
                    
                    <div class="table-responsive glass-table-wrapper">
                        <table class="table table-hover glass-table">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Product Name</th>
                                    <th scope="col">Category</th>
                                    <th scope="col">Price</th>
                                    <th scope="col">Stock</th>
                                    <th scope="col">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!--  LOOP PRODUCTS: START  -->
                                <% products.map(function(value, key) { %>
                                <tr>
                                    <td><%= key + 1 %></td>
                                    <td class="font-weight-bold"><%= value.productName %></td>
                                    <td><span class="badge badge-glass"><%= value.productCollection %></span></td>
                                    <td>$<%= value.productPrice %></td>
                                    <td><%= value.productLeftCount %></td>
                                    <td>
                                        <select class="glass-select status-select new-product-status" id="<%= value._id %>">
                                            <option value="PAUSE" <%= value.productStatus === 'PAUSE' ? 'selected': '' %>>PAUSE</option>
                                            <option value="PROCESS" <%= value.productStatus === 'PROCESS' ? 'selected': '' %>>PROCESS</option>
                                            <option value="DELETE" <%= value.productStatus === 'DELETE' ? 'selected': '' %>>DELETE</option>
                                        </select>
                                    </td>
                                </tr>
                                <% }) %>
                                <!--  LOOP PRODUCTS: END  -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- NEW PRODUCT FORM SECTION (Initially Hidden) -->
                <form onsubmit="return validateForm()" action="/admin/product/create" method="POST" class="dish-container glass-form-container" enctype="multipart/form-data" style="display: none;">
                    
                    <div class="form-header">
                         <span class="section-title">New Product Details</span>
                    </div>
                   
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label>Product Name</label>
                            <input type="text" placeholder="Enter product name" name="productName" class="glass-input product-name" />
                            <!-- PROCESS = do‘konda (React) ko‘rinadi; PAUSE = faqat admin ro‘yxatida -->
                            <input name="productStatus" value="PROCESS" class="product-status" hidden />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Price ($)</label>
                            <input type="number" placeholder="0.00" name="productPrice" class="glass-input product-price" />
                        </div>
                        <div class="form-group col-md-6">
                            <label>Stock Count</label>
                            <input type="number" placeholder="0" name="productLeftCount" class="glass-input product-left-count" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label>Category</label>
                            <select class="glass-input glass-select product-collection" name="productCollection">
                                <option value="ACCESSORIES" selected>Accessories</option>
                                <option value="ELECTIRONICS">Electronics</option>
                                <option value="BAGS">Bags</option>
                                <option value="HOMEDECOR">Homedecor</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label>Description</label>
                            <textarea name="productDesc" class="glass-input product-desc" rows="4" placeholder="Enter product description..."></textarea>
                        </div>
                    </div>

                    <div class="form-group img-frame">
                        <label>Product Images (Max 5)</label>
                        <div class="media-frame">
                            <% for(let i = 1; i <= 5; i++) { %>
                            <div class="upload-img-box glass-upload-box">
                                <img src="/img/upload.svg" class="preview-img" id="image-section-<%= i %>" alt="Upload Preview" />
                                <input type="file" id="file-<%= i %>" name="productImages" class="image-input image-<%= i %>" <%= i === 1 ? 'required' : '' %> onchange="priviewFileHandler(this, <%= i %>)" />
                                <div class="upload-overlay"><i class="fas fa-cloud-upload-alt"></i></div>
                            </div>
                            <% } %>
                        </div>
                    </div>

                    <div class="operation-buttons">
                        <button type="button" class="btn glass-btn-danger" id="cancel-btn">Cancel</button>
                        <button type="submit" class="btn glass-btn-primary" id="create-btn">Create Product</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Kerakli kutubxonalar -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.26.1/axios.min.js"></script>
    <!-- FontAwesome (ikonkalar uchun - ixtiyoriy) -->
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <!-- Three.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    
    <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>