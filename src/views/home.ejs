<%- include('includes/header') %>

<!-- Zamonaviy shriftlarni ulash (ixtiyoriy, lekin tavsiya etiladi) -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
<!-- Bizning yangi CSS faylimiz -->
<link rel="stylesheet" type="text/css" href="/css/home.css" />

<body>
  <!-- 3D Animatsiya uchun fon konteyneri -->
  <div id="canvas-container"></div>

  <div class="home-container">
    <!-- Navigatsiya menyusi (Glassmorphism uslubida) -->
    <nav class="navigation-menu glass-nav">
      <ul class="nav justify-content-center">
        <li class="nav-item">
          <a class="nav-link active" href="/admin">Home</a>
        </li>
        <% if(!member) { %>
        <li class="nav-item">
          <a class="nav-link" href="/admin/signup">Signup</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/login">Login</a>
        </li>
        <% } else { %>
        <li class="nav-item">
          <a class="nav-link" href="/admin/product/all">Menu</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/user/all">Users</a>
        </li>
        <li class="nav-item">
          <!-- Logout uchun onclick handlerini saqlab qoldik -->
          <a class="nav-link logout-btn" href="/admin/logout" onclick="return confirm('Do you want to logout?')">Logout</a>
        </li>
        <% } %>
      </ul>
    </nav>

    <!-- Asosiy kontent markazi (Kerak bo'lsa matn qo'shish uchun) -->
    <div class="hero-content">
        <h1 class="hero-title">Admin Dashboard</h1>
        <p class="hero-subtitle">Welcome to the future of management.</p>
    </div>

  </div>

  <!-- Three.js kutubxonasi (CDN orqali) - 3D uchun ZARUR -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- Bizning yangi JS faylimiz -->
  <script type="text/javascript" src="/js/home.js"></script>
</body>

<%- include('includes/footer') %>