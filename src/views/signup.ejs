<%- include('includes/header') %>

<!-- Zamonaviy shriftlarni ulash -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<!-- FontAwesome (ikonkalar uchun) -->
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
<!-- Bizning yangi CSS faylimiz -->
<link rel="stylesheet" type="text/css" href="/css/signup.css" />

<body>
  <!-- 3D Animatsiya uchun fon konteyneri -->
  <div id="canvas-container-signup"></div>

  <div class="signup-container">
    <div class="signup-frame glass-panel">
      <form onsubmit="return validateSignupForm()" action="/admin/signup" method="POST" enctype="multipart/form-data">
        
        <div class="signup-top">
          <span class="title">Create Account</span>
          <p class="subtitle">Join us today! Already a member? <a href="/admin/login" class="highlight-link">Login</a></p>
          <a href="/admin" class="back-home-link"><i class="fas fa-arrow-left"></i> Back to Home</a>
        </div>

        <div class="form-grid">
          <div class="input-group">
            <label for="memberNick">Username *</label>
            <div class="input-wrapper">
               <i class="fas fa-user input-icon"></i>
               <input type="text" id="memberNick" name="memberNick" class="glass-input member-nick" placeholder="Choose a username" required />
            </div>
          </div>
          <div class="input-group">
            <label for="memberPhone">Phone Number *</label>
            <div class="input-wrapper">
               <i class="fas fa-phone input-icon"></i>
               <input type="text" id="memberPhone" name="memberPhone" class="glass-input member-phone" placeholder="+8210-4364-1330" required />
            </div>
          </div>
        </div>

        <div class="form-grid">
          <div class="input-group">
            <label for="memberPassword">Password *</label>
             <div class="input-wrapper">
               <i class="fas fa-lock input-icon"></i>
               <input type="password" id="memberPassword" name="memberPassword" class="glass-input member-password" placeholder="Create a password" required />
            </div>
          </div>
          <div class="input-group">
            <label for="confirmPassword">Repeat Password *</label>
             <div class="input-wrapper">
               <i class="fas fa-lock input-icon"></i>
               <input type="password" id="confirmPassword" name="confirmPassword" class="glass-input confirm-password" placeholder="Confirm password" required />
            </div>
          </div>
        </div>

        <!-- Zamonaviy Rasm Yuklash Qismi -->
        <div class="image-upload-section">
          <label>Restaurant Image *</label>
          <div class="glass-upload-zone">
            <img class="preview-image" src="/img/default.jpeg" alt="Preview" />
            <div class="upload-overlay">
              <i class="fas fa-cloud-upload-alt upload-icon"></i>
              <span class="upload-text">Click to upload image</span>
              <span class="upload-hint">(JPG, JPEG, PNG only)</span>
            </div>
            <input type="file" id="input-file" class="upload-hidden member-image" name="memberImage" accept="image/png, image/jpeg, image/jpg" required/>
          </div>
        </div>

        <input name="memberType" value="RESTAURANT" hidden />

        <button class="signup-btn glass-btn-primary" name="signup" type="submit">
          Sign Up Now <i class="fas fa-user-plus btn-icon"></i>
        </button>
      
      </form>
    </div>
  </div>

  <!-- Kerakli kutubxonalar -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <!-- Three.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <script type="text/javascript" src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>